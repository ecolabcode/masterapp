{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",

    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],

    "strict": true,
    "skipLibCheck": true,

    "useDefineForClassFields": false,
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
